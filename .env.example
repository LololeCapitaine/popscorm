# =====================================================================
# Popscorm — variables d'environnement
# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# Ne committez JAMAIS `.env.local` (il est ignoré par git).
# =====================================================================

# --- Supabase (étape 2) ---------------------------------------------
# Tableau de bord Supabase > Project Settings > Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète "service role" (côté serveur uniquement, ne jamais exposer)
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (étape 3) ----------------------------------------
# Cloudflare Dashboard > R2 > Manage API Tokens (compatible S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Endpoint S3 du bucket, ex: https://<accountid>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Application ----------------------------------------------------
# URL publique de l'app (http://localhost:3000 en local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
